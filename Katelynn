<script>
/* ==================== 工具函式 ==================== */
const WD = ['日','一','二','三','四','五','六'];
const pad2 = n => String(n).padStart(2,'0');
const fmtDate = d => `${d.getFullYear()}-${pad2(d.getMonth()+1)}-${pad2(d.getDate())}`;
const parseDate = s => { const [y,m,d] = s.split('-').map(Number); return new Date(y, m-1, d); };
const addDays = (d,n) => { const x = new Date(d.getTime()); x.setDate(x.getDate()+n); return x; };
const startOfWeek = d => addDays(d, -d.getDay());
const todayStr = () => fmtDate(new Date());
const uid = () => Math.random().toString(36).slice(2,9);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* ==================== 頭像選項 ==================== */
const AVATARS_GIRL = ['👧','👩','🎀','🌸','🐰','🦄','🐱','🍓'];
const AVATARS_BOY  = ['👦','👨','⚽','🚀','🦖','🐯','🐶','🍀'];
const ALL_AVATARS  = [...new Set([...AVATARS_GIRL, ...AVATARS_BOY])];

/* ==================== 資料儲存 ==================== */
const KEY = 'kid_activities_v3';
let state = load();
let editingId = null;
let pauses = [];
let filterKid = 'all';    // 'all' 或 小朋友 id

function load(){
  try {
    const raw = localStorage.getItem(KEY)
             || localStorage.getItem('kid_activities_v2')
             || localStorage.getItem('kid_activities_v1');
    if (raw){
      const s = JSON.parse(raw);
      s.kids = s.kids || [];
      // 舊資料：若沒有小朋友，建立預設一位
      if (!s.kids.length){
        const firstColor = (s.activities||[]).find(a => a.color)?.color || '#FF9EC4';
        s.kids.push({ id: uid(), name: '寶貝', avatar: '🧒', color: firstColor });
      }
      s.kidFilter = 'all';
      (s.activities||[]).forEach(a => {
        normalize(a);
        if (!a.kidId) a.kidId = s.kids[0].id;
      });
      // 主題（女孩/男孩）
      s.theme = s.theme || 'girl';
      return s;
    }
  } catch(e){}
  return {
    kids: [{ id: uid(), name: '寶貝', avatar: '🧒', color: '#FF9EC4' }],
    activities: [],
    theme: 'girl',
    kidFilter: 'all'
  };
}
function save(){
  try { localStorage.setItem(KEY, JSON.stringify(state)); }
  catch(e){ alert('儲存失敗，瀏覽器可能封鎖了本機儲存。'); }
}
function normalize(act){
  if (!act.scheduleType){
    act.scheduleType = (act.interval === 2) ? 'biweekly' : 'weekly';
  }
  act.pauses = act.pauses || [];
  return act;
}
const kidById = id => state.kids.find(k => k.id === id) || { name:'未指定', avatar:'❓', color:'#CCCCCC' };

/* ==================== 核心：日期產生引擎 ==================== */
function generateDates(act){
  const res = [];
  const type = act.scheduleType || 'weekly';
  if (!act.startDate && type !== 'custom') return res;

  if (type === 'once') return act.startDate ? [act.startDate] : [];

  if (type === 'custom'){
    return String(act.customDates || '')
      .split(/[,，\s]+/).map(s => s.trim())
      .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s))
      .filter(s => !isNaN(parseDate(s).getTime()))
      .sort();
  }

  const start = parseDate(act.startDate);
  const end = act.endDate ? parseDate(act.endDate) : addDays(start, 90);

  if (type === 'range'){
    let d = new Date(start), guard = 0;
    while (d <= end && guard++ < 400){ res.push(fmtDate(d)); d = addDays(d, 1); }
    return [...new Set(res)].sort();
  }

  if (type === 'weekly' || type === 'biweekly'){
    const interval = type === 'biweekly' ? 2 : 1;
    const wds = [...(act.weekdays || [])].sort((a,b) => a-b);
    if (!wds.length) return res;
    let ws = startOfWeek(start), wi = 0, guard = 0;
    while (ws <= end && guard++ < 600){
      if (wi % interval === 0){
        for (const wd of wds){
          const d = addDays(ws, wd);
          if (d >= start && d <= end) res.push(fmtDate(d));
        }
      }
      ws = addDays(ws, 7); wi++;
    }
    return [...new Set(res)].sort();
  }

  if (type === 'monthlyDate'){
    const days = (act.monthDays || []).filter(n => n >= 1 && n <= 31).sort((a,b) => a-b);
    if (!days.length) return res;
    let y = start.getFullYear(), m = start.getMonth(), guard = 0;
    while (guard++ < 72){
      const monthStart = new Date(y, m, 1);
      if (monthStart > end) break;
      for (const dd of days){
        const d = new Date(y, m, dd);
        if (d.getMonth() !== m) continue;
        if (d >= start && d <= end) res.push(fmtDate(d));
      }
      m++; if (m > 11){ m = 0; y++; }
    }
    return [...new Set(res)].sort();
  }

  if (type === 'monthlyNth'){
    const nth = +act.nth || 1;
    const wd  = (act.nthWeekday !== undefined && act.nthWeekday !== null) ? +act.nthWeekday : 6;
    let y = start.getFullYear(), m = start.getMonth(), guard = 0;
    while (guard++ < 72){
      const monthStart = new Date(y, m, 1);
      if (monthStart > end) break;
      let d = null;
      if (nth === 5){
        const last = new Date(y, m + 1, 0);
        const diff = (last.getDay() - wd + 7) % 7;
        d = new Date(y, m, last.getDate() - diff);
      } else {
        const firstWd = monthStart.getDay();
        const offset = (wd - firstWd + 7) % 7;
        const day = 1 + offset + (nth - 1) * 7;
        const tmp = new Date(y, m, day);
        if (tmp.getMonth() === m) d = tmp;
      }
      if (d && d >= start && d <= end) res.push(fmtDate(d));
      m++; if (m > 11){ m = 0; y++; }
    }
    return [...new Set(res)].sort();
  }

  return [...new Set(res)].sort();
}

function getSessions(act){
  let base = generateDates(act);
  const ps = act.pauses || [];
  if (ps.length){
    base = base.filter(d => !ps.some(p => p.from && p.to && d >= p.from && d <= p.to));
  }
  const ex = new Set(act.excluded || []);
  const set = new Set(base.filter(d => !ex.has(d)));
  (act.extra || []).forEach(d => set.add(d));
  return [...set].sort();
}

function getActive(act){
  const cancelled = new Set(act.cancelled || []);
  return getSessions(act).filter(d => !cancelled.has(d));
}

function schedDesc(act){
  const t = act.scheduleType || 'weekly';
  if (t === 'weekly')      return `每週星期${(act.weekdays||[]).map(w => WD[w]).join('、')}`;
  if (t === 'biweekly')    return `隔週星期${(act.weekdays||[]).map(w => WD[w]).join('、')}`;
  if (t === 'monthlyDate') return `每月 ${(act.monthDays||[]).join('、')} 號`;
  if (t === 'monthlyNth')  return `每月第 ${act.nth === 5 ? '最後' : act.nth} 個星期${WD[act.nthWeekday] ?? ''}`;
  if (t === 'once')        return `單次活動`;
  if (t === 'range')       return `連續每天`;
  if (t === 'custom')      return `自訂日期`;
  return '';
}

/* ==================== Google 日曆 / ICS ==================== */
function buildDetails(act){
  const p = [];
  const kid = kidById(act.kidId);
  if (act.kidId) p.push('小朋友：' + kid.name);
  if (act.items)   p.push('需帶物品：' + act.items);
  if (act.fee)     p.push('每堂費用：$' + act.fee);
  if (act.tuition) p.push('學費總額：$' + act.tuition);
  return p.join('\n');
}

function gcalLink(act, dateStr){
  const [sh,sm] = (act.startTime || '09:00').split(':');
  const [eh,em] = (act.endTime   || '10:00').split(':');
  const d = dateStr.replace(/-/g,'');
  const kid = kidById(act.kidId);
  const params = new URLSearchParams({
    action:'TEMPLATE',
    text: `${kid.avatar || ''} ${act.name}`.trim(),
    dates: `${d}T${sh}${sm}00/${d}T${eh}${em}00`,
    ctz: 'Asia/Hong_Kong',
    location: act.location || '',
    details: buildDetails(act)
  });
  return 'https://calendar.google.com/calendar/render?' + params.toString();
}

const icsEsc = s => String(s || '')
  .replace(/\\/g,'\\\\').replace(/;/g,'\\;').replace(/,/g,'\\,').replace(/\r?\n/g,'\\n');

function buildICS(activities){
  const lines = [
    'BEGIN:VCALENDAR','VERSION:2.0',
    'PRODID:-//KidsActivities//ZH-Hant//EN',
    'CALSCALE:GREGORIAN','METHOD:PUBLISH'
  ];
  const stamp = new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d+/,'') + 'Z';

  activities.forEach(act => {
    const st = (act.startTime || '09:00').replace(':','') + '00';
    const en = (act.endTime   || '10:00').replace(':','') + '00';
    const cancelled = new Set(act.cancelled || []);
    const kid = kidById(act.kidId);

    getSessions(act).filter(d => !cancelled.has(d)).forEach(d => {
      const ds = d.replace(/-/g,'');
      lines.push('BEGIN:VEVENT');
      lines.push(`UID:${act.id}-${ds}@kid-activities`);
      lines.push(`DTSTAMP:${stamp}`);
      lines.push(`DTSTART;TZID=Asia/Hong_Kong:${ds}T${st}`);
      lines.push(`DTEND;TZID=Asia/Hong_Kong:${ds}T${en}`);
      lines.push(`SUMMARY:${icsEsc((kid.avatar||'') + ' ' + act.name)}`);
      if (act.location) lines.push(`LOCATION:${icsEsc(act.location)}`);
      const desc = buildDetails(act);
      if (desc) lines.push(`DESCRIPTION:${icsEsc(desc)}`);
      lines.push('BEGIN:VALARM','TRIGGER:-PT30M','ACTION:DISPLAY',
                 'DESCRIPTION:活動提醒','END:VALARM');
      lines.push('END:VEVENT');
    });
  });

  lines.push('END:VCALENDAR');
  return lines.join('\r\n');
}

function download(filename, content, type){
  const blob = new Blob([content], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1500);
}

/* ==================== 主題 ==================== */
function applyTheme(t){
  state.theme = t;
  document.body.classList.toggle('theme-boy', t === 'boy');
  document.querySelectorAll('.theme-bar button').forEach(b =>
    b.classList.toggle('active', b.dataset.theme === t)
  );
  save();
}
document.querySelectorAll('.theme-bar button').forEach(b =>
  b.addEventListener('click', () => applyTheme(b.dataset.theme))
);

/* ==================== 小朋友管理 ==================== */
function renderKids(){
