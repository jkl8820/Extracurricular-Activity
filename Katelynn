<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🌸 小朋友課外活動記錄本 🌸</title>
<style>
:root{
  --bg:#FFF9FB; --card:#FFFFFF; --line:#FFE3EC;
  --text:#5C4A63; --muted:#AD9BB6;
  --pink:#FF9EC4; --pink-dark:#F57BAA;
  --radius:22px;
  --shadow:0 4px 18px rgba(255,158,196,.16);
  --shadow-lg:0 8px 26px rgba(255,158,196,.26);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;color:var(--text);line-height:1.6;
  font-family:"Hiragino Maru Gothic ProN","Yu Gothic UI","Yu Gothic",
    "PingFang TC","Microsoft JhengHei","Noto Sans TC",-apple-system,sans-serif;
  background:
    radial-gradient(circle at 8% 4%, #FFE8F0 0%, transparent 38%),
    radial-gradient(circle at 94% 8%, #E3F2FF 0%, transparent 38%),
    radial-gradient(circle at 50% 102%, #FFF6E0 0%, transparent 52%),
    var(--bg);
  -webkit-font-smoothing:antialiased;min-height:100vh;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(#FFD1E3 1.6px, transparent 1.6px);
  background-size:26px 26px;opacity:.4;
}
/* 男孩主題：切換 body.theme-boy 時整個色系會變藍 */
body.theme-boy{
  --bg:#F4FAFF; --line:#DCEDFB; --pink:#7EC8F0; --pink-dark:#4FA8DC;
  --text:#3E5A6E; --muted:#93AEC2;
  background:
    radial-gradient(circle at 8% 4%, #E3F2FF 0%, transparent 38%),
    radial-gradient(circle at 94% 8%, #E8F7F0 0%, transparent 38%),
    radial-gradient(circle at 50% 102%, #FFF6E0 0%, transparent 52%),
    var(--bg);
}
body.theme-boy::before{background-image:radial-gradient(#C9E4F7 1.6px, transparent 1.6px)}
body.theme-boy header{background:linear-gradient(135deg,#D3ECFF 0%,#E8F5FF 45%,#E4FFF4 100%)}
body.theme-boy header h1{color:#4E7A9C}
body.theme-boy h2{color:#4E7A9C}
body.theme-boy .stat:nth-child(1){background:linear-gradient(135deg,#E0F0FF,#C6E4FF)}
body.theme-boy .stat:nth-child(2){background:linear-gradient(135deg,#E2F7EC,#C9EEDD)}
body.theme-boy .stat:nth-child(3){background:linear-gradient(135deg,#FFF6DC,#FFE9B8)}
body.theme-boy .stat:nth-child(4){background:linear-gradient(135deg,#EDE8FF,#D8E4FF)}
body.theme-boy .stat b{color:#4C6D82}
body.theme-boy button.primary{background:linear-gradient(135deg,#8FD4F5,#5FB4E4);box-shadow:0 6px 16px rgba(95,180,228,.4)}
body.theme-boy button.primary:hover{box-shadow:0 10px 22px rgba(95,180,228,.5)}
body.theme-boy .weekdays input:checked+span{background:linear-gradient(135deg,#8FD4F5,#5FB4E4)}
body.theme-boy .sched-types input:checked+span{background:linear-gradient(135deg,#8FD4F5,#5FB4E4)}
body.theme-boy summary{color:var(--pink-dark)}
body.theme-boy .form-head h2::after{display:none}

.wrap{max-width:1000px;margin:0 auto;padding:18px 16px 70px;position:relative;z-index:1}

/* 主題切換列 */
.theme-bar{
  display:flex;justify-content:center;gap:10px;margin-bottom:14px;
}
.theme-bar button{
  border:2px solid #fff;border-radius:999px;padding:9px 22px;cursor:pointer;
  font-weight:800;font-size:13px;letter-spacing:.5px;transition:.18s;
  box-shadow:0 3px 10px rgba(180,140,180,.18);
}
.theme-bar .tGirl{background:linear-gradient(135deg,#FFD9E8,#FFC0DC);color:#B25E85}
.theme-bar .tBoy{background:linear-gradient(135deg,#D3ECFF,#B8E0FA);color:#3E7BA6}
.theme-bar button.active{transform:translateY(-2px);box-shadow:0 6px 16px rgba(180,140,180,.32)}
.theme-bar button.active::after{content:' ✓'}

/* header */
header{
  position:relative;overflow:hidden;
  background:linear-gradient(135deg,#FFD9E8 0%,#FFEAF3 45%,#E4F2FF 100%);
  border:3px dashed #FFFFFF;border-radius:28px;padding:24px 20px 20px;
  margin-bottom:18px;box-shadow:var(--shadow-lg);transition:.3s;
}
header::before{content:'';position:absolute;width:120px;height:120px;top:-50px;right:-30px;
  border-radius:50%;background:rgba(255,255,255,.55)}
header::after{content:'';position:absolute;width:70px;height:70px;bottom:-30px;left:20px;
  border-radius:50%;background:rgba(255,255,255,.45)}
header h1{margin:0 0 16px;font-size:21px;letter-spacing:1px;text-align:center;
  color:#8A5C7E;position:relative;z-index:1;text-shadow:0 2px 0 #fff;transition:.3s}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative;z-index:1}
.stat{border-radius:18px;padding:12px 6px;text-align:center;
  border:2px solid #fff;box-shadow:0 3px 10px rgba(180,140,180,.12);transition:transform .18s}
.stat:hover{transform:translateY(-3px)}
.stat:nth-child(1){background:linear-gradient(135deg,#FFE3EE,#FFCFE2)}
.stat:nth-child(2){background:linear-gradient(135deg,#E2F7EC,#C9EEDD)}
.stat:nth-child(3){background:linear-gradient(135deg,#FFF6DC,#FFE9B8)}
.stat:nth-child(4){background:linear-gradient(135deg,#EAF0FF,#D8E4FF)}
.stat b{display:block;font-size:21px;line-height:1.25;color:#6E5470;transition:.3s}
.stat span{font-size:11.5px;color:#957D9E;font-weight:700}

/* card */
.card{background:var(--card);border-radius:var(--radius);padding:18px;
  margin-bottom:16px;box-shadow:var(--shadow);border:2px solid #FFF0F5;transition:.3s}
body.theme-boy .card{border-color:#EAF5FD}
h2{font-size:16px;margin:0 0 14px;display:flex;align-items:center;gap:8px;
  color:#7A5C80;transition:.3s}
h2::after{content:'';flex:1;height:2px;border-radius:2px;
  background:repeating-linear-gradient(90deg,#FFD9E8 0 8px,transparent 8px 16px)}
body.theme-boy h2::after{background:repeating-linear-gradient(90deg,#C9E4F7 0 8px,transparent 8px 16px)}

/* 小朋友管理 */
.kid-list{display:flex;flex-wrap:wrap;gap:12px}
.kid-card{
  display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:18px;
  border:2px solid #fff;box-shadow:0 3px 10px rgba(180,150,190,.14);
  min-width:210px;flex:1 1 210px;transition:.18s;position:relative;
}
.kid-card:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(180,150,190,.22)}
.kid-avatar{
  width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
  font-size:24px;background:#fff;box-shadow:0 2px 8px rgba(150,120,150,.18);flex:none;
}
.kid-info{flex:1;min-width:0}
.kid-info b{display:block;font-size:15px;color:#6E5470}
.kid-info small{color:var(--muted);font-size:11.5px;font-weight:700}
.kid-card .icon-btn{font-size:15px}
.kid-add{
  display:flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 16px;border-radius:18px;border:2px dashed #FFD9E8;
  background:#FFFCFE;color:#C09BB4;font-weight:800;cursor:pointer;
  font-size:13.5px;transition:.18s;min-width:170px;flex:1 1 170px;
}
.kid-add:hover{border-color:var(--pink);color:var(--pink-dark);background:#FFF6FA;transform:translateY(-2px)}
body.theme-boy .kid-add{border-color:#C9E4F7;color:#8FB4CC}
body.theme-boy .kid-add:hover{border-color:var(--pink);color:var(--pink-dark);background:#F2FAFF}

/* 篩選列 */
.kid-filter{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:14px}
.kid-filter button{
  border:2px solid #FFE3EC;border-radius:999px;background:#fff;cursor:pointer;
  padding:7px 16px;font-weight:800;font-size:12.5px;color:#9B82A6;transition:.16s;
  display:flex;align-items:center;gap:6px;
}
.kid-filter button:hover{border-color:var(--pink);transform:translateY(-2px)}
.kid-filter button.active{background:linear-gradient(135deg,#FFD9E8,#FFC0DC);color:#8A4E70;border-color:#fff;box-shadow:0 4px 10px rgba(255,140,185,.3)}
body.theme-boy .kid-filter button.active{background:linear-gradient(135deg,#D3ECFF,#B8E0FA);color:#33668C}

/* 表單 */
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
.field.span2{grid-column:span 2}
.field label{font-size:12.5px;color:#A98BB0;font-weight:800}
input,select,button,textarea{font:inherit;color:var(--text)}
input[type=text],input[type=date],input[type=time],input[type=number],select{
  padding:11px 13px;border:2px solid #FFE3EC;border-radius:15px;background:#FFFCFE;
  width:100%;transition:.18s;font-size:14px}
body.theme-boy input[type=text],body.theme-boy input[type=date],
body.theme-boy input[type=time],body.theme-boy input[type=number],body.theme-boy select{
  border-color:#DCEDFB;background:#FBFDFF}
input::placeholder{color:#D9C8DF}
input:focus,select:focus{outline:none;border-color:var(--pink);background:#fff;
  box-shadow:0 0 0 4px #FFE8F0}
body.theme-boy input:focus,body.theme-boy select:focus{box-shadow:0 0 0 4px #E3F2FF}
input[type=color]{width:100%;height:44px;padding:4px;border:2px solid #FFE3EC;
  border-radius:15px;background:#FFFCFE;cursor:pointer}

/* 排程方式 */
.sched-types{display:flex;gap:8px;flex-wrap:wrap}
.sched-types label{cursor:pointer}
.sched-types input{position:absolute;opacity:0;pointer-events:none}
.sched-types span{display:inline-block;padding:9px 16px;border-radius:999px;
  border:2px solid #FFE3EC;background:#FFFCFE;font-weight:800;font-size:12.5px;
  color:#BCA5C4;transition:.18s}
body.theme-boy .sched-types span{border-color:#DCEDFB;background:#FBFDFF;color:#9BB8CC}
.sched-types input:checked+span{
  background:linear-gradient(135deg,#FFB3D1,#FF8FBC);color:#fff;
  border-color:#fff;box-shadow:0 4px 10px rgba(255,140,185,.4);transform:translateY(-2px)}

.weekdays{display:flex;gap:8px;flex-wrap:wrap}
.weekdays label{cursor:pointer}
.weekdays input{position:absolute;opacity:0;pointer-events:none}
.weekdays span{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;
  border:2px solid #FFE3EC;background:#FFFCFE;font-weight:800;color:#BCA5C4;
  transition:.18s;font-size:14px}
body.theme-boy .weekdays span{border-color:#DCEDFB;background:#FBFDFF;color:#9BB8CC}
.weekdays input:checked+span{background:linear-gradient(135deg,#FFB3D1,#FF8FBC);
  color:#fff;border-color:#fff;transform:translateY(-2px);
  box-shadow:0 5px 12px rgba(255,140,185,.42)}

/* 暫停期間 */
.pause-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap}
.pause-row input{flex:1;min-width:130px}
.pause-row .tilde{color:#D4B8E0;font-weight:800}
.pDel{background:#FFF0F5;border:2px solid #FFD9E8;border-radius:12px;
  width:34px;height:38px;cursor:pointer;color:#E07A9E;font-weight:800;transition:.16s}
.pDel:hover{background:#FFD9E8}

/* 預覽 */
.preview{margin-top:12px;padding:12px 14px;border-radius:16px;
  background:linear-gradient(135deg,#FFF6FA,#F3F9FF);
  border:2px dashed #FFD9E8;font-size:12.5px;color:#8B7495;font-weight:700}
body.theme-boy .preview{background:linear-gradient(135deg,#F2FAFF,#F3F9FF);border-color:#C9E4F7}
.preview b{color:var(--pink-dark)}
.preview .dates{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.preview .dtag{background:#fff;border:1.5px solid #FFE3EC;border-radius:999px;
  padding:2px 10px;font-size:11.5px;color:#9B82A6;font-variant-numeric:tabular-nums}
body.theme-boy .preview .dtag{border-color:#DCEDFB}

/* 按鈕 */
button.primary{background:linear-gradient(135deg,#FFA9CD,#FF87B8);color:#fff;
  border:3px solid #fff;border-radius:999px;padding:13px 30px;font-weight:800;
  cursor:pointer;margin-top:16px;letter-spacing:1px;font-size:14.5px;
  box-shadow:0 6px 16px rgba(255,140,185,.4);transition:.18s}
button.primary:hover{transform:translateY(-3px);box-shadow:0 10px 22px rgba(255,140,185,.5)}
button.ghost{background:#fff;border:2px solid #FFE3EC;border-radius:999px;
  padding:8px 16px;cursor:pointer;color:#AD9BB6;font-size:13px;font-weight:700;transition:.16s}
body.theme-boy button.ghost{border-color:#DCEDFB}
button.ghost:hover{border-color:var(--pink);color:var(--pink-dark);background:#FFF6FA}
.form-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px}
.form-head h2{margin:0;flex:1}
.form-head h2::after{display:none}

/* 活動卡 */
.act{position:relative;border-left:9px solid var(--c,#FF9EC4);border-radius:20px;overflow:hidden}
.act::after{content:'';position:absolute;top:0;right:0;width:80px;height:80px;
  background:radial-gradient(circle at 100% 0%, var(--c,#FF9EC4) 0%, transparent 70%);
  opacity:.12;pointer-events:none}
.act-head{display:flex;align-items:flex-start;gap:8px;position:relative;z-index:1}
.act-head h3{margin:0;font-size:17px;flex:1;color:#6E5470}
.act .meta{display:flex;flex-wrap:wrap;gap:10px;font-size:12.5px;color:var(--muted);
  margin-top:5px;font-weight:600}
.act .owner{
  display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:800;
  padding:2px 10px;border-radius:999px;background:#fff;border:2px solid #fff;
  box-shadow:0 2px 6px rgba(180,150,190,.18);margin-bottom:4px;
}
.icon-btn{background:none;border:none;font-size:16px;cursor:pointer;padding:5px 7px;
  border-radius:12px;transition:.16s;line-height:1}
.icon-btn:hover{background:#FFEFF6;transform:scale(1.18)}

.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
.chip{font-size:12.5px;padding:5px 12px;border-radius:999px;background:#F7F1FA;
  color:#8B7495;font-weight:800;border:2px solid #fff;
  box-shadow:0 2px 6px rgba(180,150,190,.12)}
.chip.ok{background:#DFF6EA;color:#3E9C77}
.chip.next{background:#FFF3D6;color:#C2882A}
.chip.money{background:#EDE8FF;color:#7061C9}
.chip.pause{background:#FFE9E9;color:#C46161}

.items{margin:12px 0 0;font-size:13px;color:#7E6885;background:#FFF7FB;
  border-radius:14px;padding:9px 14px;border:2px dashed #FFE0EE;font-weight:600}
body.theme-boy .items{background:#F5FBFF;border-color:#DCEDFB;color:#5E7E96}

details{margin-top:14px;border-top:2px dashed #FFE9F2;padding-top:12px}
summary{cursor:pointer;font-size:13.5px;font-weight:800;color:var(--pink-dark);
  list-style:none;user-select:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"🌸 ";display:inline-block;transition:.25s}
body.theme-boy summary::before{content:"💙 "}
details[open] summary::before{transform:rotate(72deg)}
ul.sessions{list-style:none;padding:0;margin:12px 0 0;max-height:300px;overflow:auto}
ul.sessions li{display:flex;align-items:center;gap:8px;font-size:13px;padding:7px 10px;
  border-radius:12px;font-weight:600;transition:.16s}
ul.sessions li:nth-child(odd){background:#FFFAFC}
body.theme-boy ul.sessions li:nth-child(odd){background:#F8FCFF}
ul.sessions li:hover{background:#FFF0F7}
ul.sessions li.done{color:#B6A6BE}
ul.sessions li.done .sdate{text-decoration:line-through}
ul.sessions li.now{background:#FFF3D6;color:#B87F1E;font-weight:800}
ul.sessions li.off{opacity:.42}
ul.sessions li.off .sdate{text-decoration:line-through}
.sdate{min-width:122px;font-variant-numeric:tabular-nums}
.stst{font-size:11px;padding:3px 9px;border-radius:999px;background:#F4EEF8;
  color:#9C87A6;font-weight:800;white-space:nowrap}
li.now .stst{background:#FFE7B0;color:#9A6A12}
li.done .stst{background:#D8F3E6;color:#368C69}
button.mini{background:none;border:none;cursor:pointer;font-size:12px;color:#B7A4BF;
  padding:3px 8px;border-radius:9px;font-weight:700;transition:.16s}
button.mini:hover{background:#FFE8F3;color:var(--pink-dark)}
a.mini{text-decoration:none;font-size:13px;padding:3px 6px;border-radius:9px;transition:.16s}
a.mini:hover{background:#FFE8F3}

.row-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
.row-actions button{font-size:12.5px;background:#FFF7FB;border:2px solid #FFE3EC;
  border-radius:999px;padding:7px 15px;cursor:pointer;color:#9B82A6;font-weight:800;transition:.16s}
body.theme-boy .row-actions button{background:#F5FBFF;border-color:#DCEDFB}
.row-actions button:hover{border-color:var(--pink);color:var(--pink-dark);
  background:#FFEDF5;transform:translateY(-2px)}

/* 圖表 */
.bar-row{display:grid;grid-template-columns:112px 1fr 68px;align-items:center;
  gap:11px;margin-bottom:12px;font-size:13px}
.bar-label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  font-weight:800;color:#7A6482}
.bar-track{height:20px;background:#F7F0FA;border-radius:999px;overflow:hidden}
body.theme-boy .bar-track{background:#EFF7FC}
.bar-fill{height:100%;border-radius:999px;transition:width .45s;
  background-image:linear-gradient(45deg,rgba(255,255,255,.45) 25%,transparent 25%,
    transparent 50%,rgba(255,255,255,.45) 50%,rgba(255,255,255,.45) 75%,transparent 75%);
  background-size:14px 14px;animation:stripe 1.1s linear infinite}
@keyframes stripe{from{background-position:0 0}to{background-position:14px 0}}
.bar-val{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums;
  font-size:12.5px;font-weight:800}
.empty{color:#C5B2CD;text-align:center;padding:30px 0;font-size:14px;font-weight:700}

ul.sessions::-webkit-scrollbar{width:8px}
ul.sessions::-webkit-scrollbar-track{background:#FFF3F8;border-radius:9px}
ul.sessions::-webkit-scrollbar-thumb{background:#FFC9DE;border-radius:9px}

@keyframes floaty{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-7px) rotate(6deg)}}
header h1::before{content:'🌸';display:inline-block;margin-right:8px;
  animation:floaty 3s ease-in-out infinite}
header h1::after{content:'🌸';display:inline-block;margin-left:8px;
  animation:floaty 3s ease-in-out infinite .6s}
body.theme-boy header h1::before,
body.theme-boy header h1::after{content:'💙'}

[hidden]{display:none!important}

@media(max-width:560px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .field.span2{grid-column:span 1}
  .bar-row{grid-template-columns:84px 1fr 60px}
  .sdate{min-width:98px}
  header h1{font-size:17px}
}
</style>
</head>
<body>
<div class="wrap">

  <!-- 主題切換 -->
  <div class="theme-bar">
    <button type="button" class="tGirl active" data-theme="girl">👧 女孩版</button>
    <button type="button" class="tBoy" data-theme="boy">👦 男孩版</button>
  </div>

  <header>
    <h1>小朋友課外活動記錄本</h1>
    <div class="stats">
      <div class="stat"><b id="statKids">0</b><span>🧒 小朋友</span></div>
      <div class="stat"><b id="statDone">0</b><span>✅ 已上課堂</span></div>
      <div class="stat"><b id="statUp">0</b><span>⏳ 待上課堂</span></div>
      <div class="stat"><b id="statMoney">$0</b><span>💰 已花費</span></div>
    </div>
  </header>

  <!-- 小朋友管理 -->
  <section class="card">
    <h2>🧒 我的小朋友</h2>
    <div class="kid-list" id="kidList"></div>
    <p style="font-size:12.5px;color:var(--muted);font-weight:700;margin:12px 0 0">
      💡 新增活動時可選擇屬於哪一位小朋友，方便分開記錄與統計。
    </p>
  </section>

  <!-- 篩選 -->
  <div class="kid-filter" id="kidFilter"></div>

  <!-- 新增／編輯活動 -->
  <form id="actForm" class="card">
    <div class="form-head">
      <h2 id="formTitle">➕ 新增活動</h2>
      <button type="button" id="cancelEdit" class="ghost" hidden>取消編輯</button>
    </div>

    <div class="form-grid">
      <div class="field">
        <label>🧒 屬於哪位小朋友 *</label>
        <select name="kidId" id="kidSelect" required></select>
      </div>

      <div class="field">
        <label>🎀 活動名稱 *</label>
        <input name="name" type="text" required placeholder="例：游泳班">
      </div>

      <div class="field span2">
        <label>📍 活動地點</label>
        <input name="location" type="text" placeholder="例：XX 游泳池">
      </div>

      <div class="field span2">
        <label>🗓️ 排程方式（活動不一定每週都有？這裡可以選）</label>
        <div class="sched-types" id="schedTypes">
          <label><input type="radio" name="scheduleType" value="weekly" checked><span>每週固定</span></label>
          <label><input type="radio" name="scheduleType" value="biweekly"><span>隔週</span></label>
          <label><input type="radio" name="scheduleType" value="monthlyDate"><span>每月某幾日</span></label>
