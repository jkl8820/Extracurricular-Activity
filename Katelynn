        <small>${counts[k.id] || 0} 個活動</small>
      </div>
      <button class="icon-btn" data-edit-kid="${k.id}" title="編輯">✏️</button>
      <button class="icon-btn" data-del-kid="${k.id}" title="刪除">🗑️</button>
    </div>
  `).join('') + `
    <div class="kid-add" id="addKid">＋ 新增小朋友</div>
  `;

  // 小朋友下拉選單
  const sel = document.getElementById('kidSelect');
  const keep = sel.value;
  sel.innerHTML = state.kids.map(k =>
    `<option value="${k.id}">${k.avatar} ${esc(k.name)}</option>`
  ).join('');
  if (state.kids.some(k => k.id === keep)) sel.value = keep;
}

document.getElementById('kidList').addEventListener('click', e => {
  const btn = e.target.closest('button');
  if (btn?.dataset.editKid) return editKid(btn.dataset.editKid);
  if (btn?.dataset.delKid)  return deleteKid(btn.dataset.delKid);
  if (e.target.closest('#addKid')) return addKid();
});

function addKid(){
  const name = prompt('小朋友的名字：', '');
  if (name === null) return;
  const trimmed = name.trim();
  if (!trimmed){ alert('請輸入名字 🌸'); return; }

  // 選頭像
  const pool = state.theme === 'boy' ? AVATARS_BOY : AVATARS_GIRL;
  const avatar = prompt(
    `選一個頭像（輸入數字）：\n${pool.map((a,i) => `${i+1}. ${a}`).join('\n')}`,
    '1'
  );
  const idx = Math.max(0, Math.min(pool.length - 1, (parseInt(avatar,10) || 1) - 1));

  // 選顏色
  const colors = ['#FF9EC4','#FFB7A5','#FFD98E','#A8DFC0','#A8D8EA','#C9B6F0'];
  const kid = {
    id: uid(),
    name: trimmed,
    avatar: pool[idx],
    color: colors[state.kids.length % colors.length]
  };
  state.kids.push(kid);
  save();
  renderKids();
  renderKidFilter();
  renderAll();
}

function editKid(id){
  const k = state.kids.find(x => x.id === id);
  if (!k) return;

  const name = prompt('修改名字：', k.name);
  if (name === null) return;
  const trimmed = name.trim();
  if (!trimmed){ alert('名字不能空白 🌸'); return; }
  k.name = trimmed;

  const pool = ALL_AVATARS;
  const cur = pool.indexOf(k.avatar);
  const avatar = prompt(
    `選一個頭像（輸入數字）：\n${pool.map((a,i) => `${i+1}. ${a}`).join('\n')}`,
    String(cur >= 0 ? cur + 1 : 1)
  );
  if (avatar !== null){
    const idx = Math.max(0, Math.min(pool.length - 1, (parseInt(avatar,10) || 1) - 1));
    k.avatar = pool[idx];
  }

  const color = prompt('代表顏色（十六進位，例：#FF9EC4）：', k.color);
  if (color && /^#[0-9A-Fa-f]{6}$/.test(color.trim())) k.color = color.trim();

  save();
  renderKids();
  renderKidFilter();
  renderAll();
}

function deleteKid(id){
  const k = state.kids.find(x => x.id === id);
  if (!k) return;
  if (state.kids.length <= 1){ alert('至少需要保留一位小朋友 🌸'); return; }

  const n = state.activities.filter(a => a.kidId === id).length;
  const msg = n
    ? `「${k.name}」有 ${n} 個活動，刪除小朋友會同時刪除這些活動。確定嗎？`
    : `確定刪除「${k.name}」？`;
  if (!confirm(msg)) return;

  state.kids = state.kids.filter(x => x.id !== id);
  state.activities = state.activities.filter(a => a.kidId !== id);
  if (filterKid === id) filterKid = 'all';
  if (editingId){
    const cur = state.activities.find(a => a.id === editingId);
    if (!cur) endEdit();
  }
  save();
  renderKids();
  renderKidFilter();
  renderAll();
}

/* ==================== 篩選列 ==================== */
function renderKidFilter(){
  const box = document.getElementById('kidFilter');
  const counts = { all: state.activities.length };
  state.activities.forEach(a => { counts[a.kidId] = (counts[a.kidId]||0)+1; });

  box.innerHTML = `
    <button data-kid="all" class="${filterKid==='all'?'active':''}">
      🌈 全部 <span style="opacity:.75">(${counts.all||0})</span>
    </button>
    ${state.kids.map(k => `
      <button data-kid="${k.id}" class="${filterKid===k.id?'active':''}">
        ${k.avatar} ${esc(k.name)}
        <span style="opacity:.75">(${counts[k.id]||0})</span>
      </button>
    `).join('')}
  `;
}

document.getElementById('kidFilter').addEventListener('click', e => {
  const btn = e.target.closest('button');
  if (!btn) return;
  filterKid = btn.dataset.kid;
  renderKidFilter();
  renderAll();
});

/* ==================== 渲染 ==================== */
function filteredActivities(){
  return filterKid === 'all'
    ? state.activities
    : state.activities.filter(a => a.kidId === filterKid);
}

function renderAll(){
  renderStats();
  renderActivities();
  renderChart();
}

function renderStats(){
  const today = todayStr();
  let done = 0, up = 0, money = 0;
  filteredActivities().forEach(a => {
    const list = getActive(a);
    const d = list.filter(x => x < today);
    done  += d.length;
    up    += list.length - d.length;
    money += d.length * (a.fee || 0);
  });
  document.getElementById('statKids').textContent  = state.kids.length;
  document.getElementById('statDone').textContent  = done;
  document.getElementById('statUp').textContent    = up;
  document.getElementById('statMoney').textContent = '$' + money.toLocaleString();
}

function renderActivities(){
  const box = document.getElementById('activityList');
  const list = filteredActivities();

  // 標題
  const title = document.getElementById('listTitle');
  if (filterKid === 'all'){
    title.textContent = '📋 活動列表（全部小朋友）';
  } else {
    const k = kidById(filterKid);
    title.textContent = `📋 ${k.avatar} ${k.name} 的活動`;
  }

  if (!list.length){
    box.innerHTML = '<div class="card empty">🌈 還沒有活動紀錄，先在上面新增一個吧 👆</div>';
    return;
  }
  box.innerHTML = list.map(actHTML).join('');
}

function actHTML(act){
  const today = todayStr();
  const cancelled = new Set(act.cancelled || []);
  const all = getSessions(act);
  const active = all.filter(d => !cancelled.has(d));
  const done = active.filter(d => d < today);
  const up = active.filter(d => d >= today);
  const next = up[0];
  const kid = kidById(act.kidId);

  const rows = all.map(d => {
    const wd = WD[parseDate(d).getDay()];
    const off = cancelled.has(d);
    let status = '待上', cls = '';
    if (off){ status = '已取消'; cls = 'off'; }
    else if (d < today){ status = '已上'; cls = 'done'; }
    else if (d === today){ status = '今天'; cls = 'now'; }

    const gcal = off ? '' :
      `<a class="mini" target="_blank" rel="noopener" title="加入 Google 日曆"
          href="${gcalLink(act, d)}">📅</a>`;

    return `<li class="${cls}">
      <span class="sdate">${d}（${wd}）</span>
      <span class="stst">${status}</span>
      ${gcal}
      <button class="mini" data-cancel="${act.id}|${d}">${off ? '復原' : '請假'}</button>
      <button class="mini" data-rm="${act.id}|${d}" title="移除這堂">✕</button>
    </li>`;
  }).join('');

  const meta = [
    `🕒 ${act.startTime || '—'}–${act.endTime || '—'}`,
    `🗓️ ${schedDesc(act)}`,
    act.location ? `📍 ${esc(act.location)}` : ''
  ].filter(Boolean).join('　');

  const pauseCount = (act.pauses || []).length;

  return `<article class="card act" style="--c:${act.color || '#FF9EC4'}">
    <div class="act-head">
      <div style="flex:1">
        <span class="owner" style="background:${kid.color}22;color:${kid.color};border-color:${kid.color}55">
          ${kid.avatar} ${esc(kid.name)}
        </span>
        <h3>${esc(act.name)}</h3>
        <div class="meta">${meta}</div>
      </div>
      <button class="icon-btn" data-edit="${act.id}" title="編輯">✏️</button>
      <button class="icon-btn" data-del="${act.id}" title="刪除">🗑️</button>
    </div>

    <div class="chips">
      <span class="chip ok">✅ 已上 ${done.length} 堂</span>
      <span class="chip">⏳ 剩 ${up.length} 堂</span>
      <span class="chip">📚 共 ${active.length} 堂</span>
      ${next ? `<span class="chip next">🔔 下次：${next}（星期${WD[parseDate(next).getDay()]}）</span>` : ''}
      ${pauseCount ? `<span class="chip pause">⏸️ ${pauseCount} 段暫停</span>` : ''}
      <span class="chip money">💰 每堂 $${act.fee || 0}</span>
      ${act.tuition ? `<span class="chip money">🏦 學費 $${act.tuition}</span>` : ''}
      <span class="chip money">💸 已花費 $${(done.length * (act.fee || 0)).toLocaleString()}</span>
    </div>

    ${act.items ? `<p class="items">🎒 需帶：${esc(act.items)}</p>` : ''}

    <details>
      <summary>課堂列表（共 ${all.length} 堂）</summary>
      <ul class="sessions">${rows || '<li>沒有課堂</li>'}</ul>
      <div class="row-actions">
        <button data-add-session="${act.id}">＋ 手動新增一堂</button>
        <button data-ics="${act.id}">⬇️ 匯出此活動 .ics</button>
      </div>
    </details>
  </article>`;
}

function renderChart(){
  const today = todayStr();
  const data = filteredActivities().map(a => {
    const list = getActive(a);
    const done = list.filter(d => d < today).length;
    const kid = kidById(a.kidId);
    return {
      name: `${kid.avatar} ${a.name}`,
      color: a.color || '#FF9EC4',
      done, total: list.length
    };
  }).filter(d => d.total > 0);

  const box = document.getElementById('chart');
  if (!data.length){ box.innerHTML = '<p class="empty">🌸 還沒有課堂紀錄</p>'; return; }

  const max = Math.max(...data.map(d => d.total), 1);
  box.innerHTML = data.map(d => {
    const pct = Math.round(d.done / d.total * 100);
    const trackW = Math.max(24, Math.round(d.total / max * 100));
    return `<div class="bar-row">
      <div class="bar-label" title="${esc(d.name)}">${esc(d.name)}</div>
      <div class="bar-track" style="width:${trackW}%">
        <div class="bar-fill" style="width:${pct}%;background-color:${d.color}"></div>
      </div>
      <div class="bar-val">${d.done}/${d.total}</div>
    </div>`;
  }).join('');
}

/* ==================== 表單：星期 & 每月第幾個 ==================== */
(function buildWeekdays(){
  document.getElementById('weekdayBox').innerHTML =
    [1,2,3,4,5,6,0].map(w =>
      `<label><input type="checkbox" name="weekday" value="${w}"><span>${WD[w]}</span></label>`
    ).join('');
  document.querySelector('[name=nthWeekday]').innerHTML =
    [1,2,3,4,5,6,0].map(w => `<option value="${w}">星期${WD[w]}</option>`).join('');
})();

const form = document.getElementById('actForm');

/* ==================== 排程面板切換 ==================== */
function currentType(){
  return form.querySelector('input[name=scheduleType]:checked').value;
}
function updatePanels(){
  const t = currentType();
  document.querySelectorAll('.sched-panel').forEach(p => {
    p.hidden = !p.dataset.panel.split(' ').includes(t);
  });
  const lblStart = document.getElementById('lblStart');
  const lblEnd   = document.getElementById('lblEnd');
  if (t === 'once'){
    lblStart.textContent = '📆 活動日期 *';
    lblEnd.textContent   = '🏁 結束日期（單次活動不需要）';
  } else if (t === 'range'){
    lblStart.textContent = '📆 開始日期 *';
    lblEnd.textContent   = '🏁 結束日期 *（連續每天到這天）';
  } else if (t === 'custom'){
    lblStart.textContent = '📆 開始日期（可留空）';
    lblEnd.textContent   = '🏁 結束日期（不需要）';
  } else {
    lblStart.textContent = '📆 開始日期 *';
    lblEnd.textContent   = '🏁 結束日期（留空＝自動 3 個月）';
  }
  updatePreview();
}
form.querySelectorAll('input[name=scheduleType]').forEach(r =>
  r.addEventListener('change', updatePanels)
);

/* ==================== 暫停期間 ==================== */
function renderPauses(){
  const box = document.getElementById('pauseList');
  if (!pauses.length){ box.innerHTML = ''; return; }
  box.innerHTML = pauses.map((p,i) => `
    <div class="pause-row" data-i="${i}">
      <input type="date" class="pFrom" value="${p.from || ''}">
      <span class="tilde">～</span>
      <input type="date" class="pTo" value="${p.to || ''}">
      <button type="button" class="pDel" title="刪除">✕</button>
    </div>`).join('');
}
document.getElementById('addPause').addEventListener('click', () => {
  pauses.push({ from: '', to: '' });
  renderPauses();
});
document.getElementById('pauseList').addEventListener('input', e => {
  const row = e.target.closest('.pause-row');
  if (!row) return;
  const i = +row.dataset.i;
  pauses[i].from = row.querySelector('.pFrom').value;
  pauses[i].to   = row.querySelector('.pTo').value;
  updatePreview();
});
document.getElementById('pauseList').addEventListener('click', e => {
  if (!e.target.classList.contains('pDel')) return;
  const row = e.target.closest('.pause-row');
  pauses.splice(+row.dataset.i, 1);
  renderPauses();
  updatePreview();
});

/* ==================== 從表單讀出臨時活動物件 ==================== */
function formToAct(){
  const v = sel => form.querySelector(sel)?.value ?? '';
  const monthDays = String(v('[name=monthDays]'))
    .split(/[,，\s]+/).map(x => parseInt(x,10))
    .filter(n => n >= 1 && n <= 31);
  return {
    scheduleType: currentType(),
    weekdays: [...form.querySelectorAll('input[name=weekday]:checked')].map(x => +x.value),
    monthDays,
    nth: +v('[name=nth]') || 1,
    nthWeekday: +v('[name=nthWeekday]'),
    customDates: v('[name=customDates]'),
    startDate: v('[name=startDate]'),
    endDate: v('[name=endDate]'),
    pauses: pauses.filter(p => p.from && p.to)
  };
}

/* ==================== 即時預覽 ==================== */
function updatePreview(){
  const box = document.getElementById('preview');
  let act;
  try { act = formToAct(); } catch(e){ return; }

  const dates = generateDates(act).filter(d =>
    !act.pauses.some(p => d >= p.from && d <= p.to)
  );

  if (!dates.length){
    box.innerHTML = '🌸 填好上面的資料，這裡會即時顯示會產生幾堂課。';
    return;
  }

  const shown = dates.slice(0, 14);
  const more  = dates.length - shown.length;

  box.innerHTML = `✨ 將會產生 <b>${dates.length}</b> 堂課
    ${act.pauses.length ? `（已扣掉 ${act.pauses.length} 段暫停期間）` : ''}
    <div class="dates">
      ${shown.map(d => `<span class="dtag">${d}（${WD[parseDate(d).getDay()]}）</span>`).join('')}
      ${more > 0 ? `<span class="dtag">…還有 ${more} 堂</span>` : ''}
    </div>`;
}

form.addEventListener('input', updatePreview);
form.addEventListener('change', updatePreview);

/* ==================== 表單重設 / 編輯 ==================== */
function resetForm(){
  form.reset();
  form.querySelector('[name=startDate]').value = todayStr();
  form.querySelector('[name=color]').value = '#FF9EC4';
  form.querySelector('[name=startTime]').value = '16:00';
  form.querySelector('[name=endTime]').value = '17:00';
  form.querySelector('input[name=scheduleType][value=weekly]').checked = true;
  // 預設選目前篩選的小朋友
  const sel = document.getElementById('kidSelect');
  if (filterKid !== 'all' && state.kids.some(k => k.id === filterKid)) sel.value = filterKid;
  pauses = [];
  renderPauses();
  updatePanels();
}

function endEdit(){
  editingId = null;
  document.getElementById('formTitle').textContent = '➕ 新增活動';
  document.getElementById('submitBtn').textContent = '✿ 新增活動 ✿';
  document.getElementById('cancelEdit').hidden = true;
  resetForm();
}

form.addEventListener('submit', e => {
  e.preventDefault();

  const weekdays = [...form.querySelectorAll('input[name=weekday]:checked')].map(x => +x.value);
  const t = currentType();
  const kidId = form.querySelector('[name=kidId]').value;

  if (!kidId){ alert('請選擇一位小朋友 🌸'); return; }
  if ((t === 'weekly' || t === 'biweekly') && !weekdays.length){
    alert('請至少選擇一個上課日 🌸'); return;
  }
  if (t === 'monthlyDate'){
    const md = String(form.querySelector('[name=monthDays]').value)
      .split(/[,，\s]+/).map(x => parseInt(x,10)).filter(n => n >= 1 && n <= 31);
    if (!md.length){ alert('請輸入每月幾號，例如：5,20 🌸'); return; }
  }
  if (t === 'custom' && !form.querySelector('[name=customDates]').value.trim()){
    alert('請輸入自訂日期，例如：2025-03-01, 2025-03-15 🌸'); return;
  }
  if (t !== 'custom' && !form.querySelector('[name=startDate]').value){
    alert('請填寫開始日期 🌸'); return;
  }
  if (t === 'range' && !form.querySelector('[name=endDate]').value){
    alert('「連續幾天」需要填寫結束日期 🌸'); return;
  }

  const data = {
    kidId,
    scheduleType: t,
    name:      form.querySelector('[name=name]').value.trim(),
    location:  form.querySelector('[name=location]').value.trim(),
    weekdays,
    monthDays: String(form.querySelector('[name=monthDays]').value)
                 .split(/[,，\s]+/).map(x => parseInt(x,10)).filter(n => n >= 1 && n <= 31),
    nth:        +form.querySelector('[name=nth]').value || 1,
    nthWeekday: +form.querySelector('[name=nthWeekday]').value,
    customDates: form.querySelector('[name=customDates]').value.trim(),
    startTime: form.querySelector('[name=startTime]').value,
    endTime:   form.querySelector('[name=endTime]').value,
    startDate: form.querySelector('[name=startDate]').value,
    endDate:   form.querySelector('[name=endDate]').value,
    fee:       +form.querySelector('[name=fee]').value || 0,
    tuition:   +form.querySelector('[name=tuition]').value || 0,
    color:     form.querySelector('[name=color]').value,
    items:     form.querySelector('[name=items]').value.trim(),
    pauses:    pauses.filter(p => p.from && p.to)
  };

  if (!data.name){ alert('請填寫活動名稱 🌸'); return; }

  if (editingId){
    const act = state.activities.find(x => x.id === editingId);
    Object.assign(act, data);
  } else {
    state.activities.push({
      id: uid(), ...data,
      excluded: [], extra: [], cancelled: []
    });
  }

  save();
  endEdit();
  renderKids();
  renderKidFilter();
  renderAll();
});

document.getElementById('cancelEdit').addEventListener('click', endEdit);

form.querySelectorAll('.swatches button').forEach(b => {
  b.addEventListener('click', () => {
    form.querySelector('[name=color]').value = b.dataset.color;
  });
});

/* ==================== 活動列表互動 ==================== */
document.getElementById('activityList').addEventListener('click', e => {
  const btn = e.target.closest('button');
  if (!btn) return;
  const ds = btn.dataset;

  if (ds.edit)            startEdit(ds.edit);
  else if (ds.del)        deleteActivity(ds.del);
  else if (ds.cancel)     toggleCancel(ds.cancel);
  else if (ds.rm)         removeSession(ds.rm);
  else if (ds.addSession) addSession(ds.addSession);
  else if (ds.ics)        exportOneICS(ds.ics);
});

function startEdit(id){
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  normalize(a);
  editingId = id;

  const q = sel => form.querySelector(sel);
  q('[name=kidId]').value       = a.kidId || state.kids[0].id;
  q('[name=name]').value        = a.name || '';
  q('[name=location]').value    = a.location || '';
  q('[name=startTime]').value   = a.startTime || '16:00';
  q('[name=endTime]').value     = a.endTime || '17:00';
  q('[name=startDate]').value   = a.startDate || '';
  q('[name=endDate]').value     = a.endDate || '';
  q('[name=fee]').value         = a.fee || 0;
  q('[name=tuition]').value     = a.tuition || 0;
  q('[name=color]').value       = a.color || '#FF9EC4';
  q('[name=items]').value       = a.items || '';
  q('[name=monthDays]').value   = (a.monthDays || []).join(',');
  q('[name=customDates]').value = a.customDates || '';
  q('[name=nth]').value         = a.nth || 1;
  q('[name=nthWeekday]').value  = (a.nthWeekday !== undefined) ? a.nthWeekday : 6;

  const radio = form.querySelector(`input[name=scheduleType][value="${a.scheduleType || 'weekly'}"]`);
  if (radio) radio.checked = true;

  form.querySelectorAll('input[name=weekday]').forEach(cb => {
    cb.checked = (a.weekdays || []).includes(+cb.value);
  });

  pauses = (a.pauses || []).map(p => ({ from: p.from, to: p.to }));
  renderPauses();

  document.getElementById('formTitle').textContent = '✏️ 編輯活動';
  document.getElementById('submitBtn').textContent = '✿ 儲存修改 ✿';
  document.getElementById('cancelEdit').hidden = false;

  updatePanels();
  form.scrollIntoView({ behavior:'smooth', block:'start' });
}

function deleteActivity(id){
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  if (!confirm(`確定刪除「${a.name}」？所有課堂紀錄會一併移除。`)) return;
  state.activities = state.activities.filter(x => x.id !== id);
  if (editingId === id) endEdit();
  save(); renderKids(); renderKidFilter(); renderAll();
}

function toggleCancel(key){
  const [id, d] = key.split('|');
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  a.cancelled = a.cancelled || [];
  a.cancelled = a.cancelled.includes(d)
    ? a.cancelled.filter(x => x !== d)
    : [...a.cancelled, d];
  save(); renderAll();
}

function removeSession(key){
  const [id, d] = key.split('|');
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  if ((a.extra || []).includes(d)){
    a.extra = a.extra.filter(x => x !== d);
  } else if (a.scheduleType === 'custom'){
    a.customDates = String(a.customDates || '')
      .split(/[,，\s]+/).map(s => s.trim())
      .filter(s => s && s !== d).join(', ');
  } else {
    a.excluded = [...new Set([...(a.excluded || []), d])];
  }
  a.cancelled = (a.cancelled || []).filter(x => x !== d);
  save(); renderAll();
}

function addSession(id){
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  const input = prompt('輸入課堂日期（格式 YYYY-MM-DD）：', todayStr());
  if (input === null) return;
  const d = input.trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(d) || isNaN(parseDate(d).getTime())){
    alert('日期格式不正確，請用 YYYY-MM-DD，例如 2025-03-08');
    return;
  }
  a.extra = [...new Set([...(a.extra || []), d])];
  a.excluded = (a.excluded || []).filter(x => x !== d);
  a.cancelled = (a.cancelled || []).filter(x => x !== d);
  save(); renderAll();
}

/* ==================== 匯出 ==================== */
function exportOneICS(id){
  const a = state.activities.find(x => x.id === id);
  if (!a) return;
  const kid = kidById(a.kidId);
  download(`${kid.name}-${a.name}.ics`, buildICS([a]), 'text/calendar;charset=utf-8');
}

document.getElementById('exportAll').addEventListener('click', () => {
  if (!state.activities.length){ alert('還沒有任何活動 🌸'); return; }
  download('課外活動.ics', buildICS(state.activities), 'text/calendar;charset=utf-8');
});

document.getElementById('clearAll').addEventListener('click', () => {
  if (!state.activities.length && state.kids.length <= 1) return;
  if (!confirm('確定清除全部資料（包含小朋友與活動）？此動作無法復原。')) return;
  state = {
    kids: [{ id: uid(), name: '寶貝', avatar: '🧒', color: '#FF9EC4' }],
    activities: [], theme: state.theme, kidFilter: 'all'
  };
  filterKid = 'all';
  save(); endEdit();
  renderKids(); renderKidFilter(); renderAll();
});

/* ==================== 啟動 ==================== */
applyTheme(state.theme || 'girl');
resetForm();
renderKids();
renderKidFilter();
renderAll();
</script>
